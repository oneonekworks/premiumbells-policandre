{
  "meta": {
    "name": "Premium Bells",
    "version": "v6 Clarity · v6.2 release candidate (2026-11-17)",
    "note": "Final source of truth; mirrors tokens.css"
  },
  "color": {
    "ground": {
      "value": "#ffffff",
      "role": "page ground, odd sections"
    },
    "surface": {
      "value": "#ffffff",
      "role": "cards, panels"
    },
    "band": {
      "value": "#eef2f1",
      "role": "alternate sections; neighbours never share a ground"
    },
    "hairline": {
      "value": "rgba(17,26,25,0.10)",
      "role": "1px borders inside cards and tables; never between sections"
    },
    "ink": {
      "value": "#111a19",
      "role": "text",
      "contrast": {
        "white": 17.71,
        "band": 15.69,
        "teal-tint": 15.13
      }
    },
    "ink-soft": {
      "value": "#4a5553",
      "role": "meta, kickers, captions",
      "contrast": {
        "white": 7.73,
        "band": 6.85,
        "teal-tint": 6.6
      }
    },
    "teal-tint": {
      "value": "#e6efed",
      "role": "hover/active backgrounds, note chips"
    },
    "teal-700": {
      "value": "#0f6b63",
      "role": "links, italic sublines, map dots",
      "contrast": {
        "white": 6.36,
        "band": 5.63,
        "teal-tint": 5.43
      }
    },
    "teal-900": {
      "value": "#0e3a36",
      "role": "primary button, play, active chip",
      "contrast": {
        "white-on": 12.52,
        "as-text-on-teal-tint": 10.69
      }
    },
    "teal-950": {
      "value": "#0b2523",
      "role": "the two inset dark panels per page"
    },
    "on-dark": {
      "value": "#eef3f1",
      "role": "text on teal-950",
      "contrast": {
        "teal-950": 14.37
      }
    },
    "on-dark-soft": {
      "value": "#a9bdb8",
      "role": "meta on teal-950",
      "contrast": {
        "teal-950": 8.18
      }
    },
    "focus": {
      "value": "#9a783e",
      "role": "3px focus ring on light (non-text, ≥3:1)",
      "contrast": {
        "white": 4.09,
        "band": 3.63
      }
    },
    "focus-on-dark": {
      "value": "#c9a467",
      "role": "focus ring on teal-950 and lightbox; played waveform",
      "contrast": {
        "teal-950": 6.9
      }
    },
    "ornament": {
      "value": "#b8955a",
      "role": "the bell ornament (footer) only",
      "contrast": {
        "teal-950": 5.74
      }
    },
    "photo-veil": {
      "value": "rgba(10,18,17,0.34)",
      "role": "flat veil under white text on photos"
    },
    "overlay": {
      "value": "rgba(14,58,54,0.60)",
      "role": "Lightbox / layer backdrop with blur(12px) saturate(1.4); fallback rgba(14,58,54,0.96); edge gradients rgba(9,40,37,.85→0) top 140/120 and .88→0 bottom 240/280"
    },
    "overlay-text": {
      "value": "#eef3f1"
    },
    "overlay-soft": {
      "value": "#c9d6d2",
      "role": "meta on overlays, ≥4.5:1 over a white page"
    },
    "graphite": {
      "value": "#33363b",
      "role": "Clopote active chip, bell-type chip outline"
    }
  },
  "font": {
    "display": "\"Cormorant Garamond\", Garamond, \"Times New Roman\", serif",
    "sans": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "rules": "Cormorant 500-600 for display, section titles, card names. Inter for UI and body; minimum 14px, legal line 13px."
  },
  "type": {
    "hero": {
