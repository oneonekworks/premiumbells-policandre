  "shadow": {
    "e0": "none",
    "e1": "0 1px 2px rgba(11,37,35,0.06), 0 6px 16px rgba(11,37,35,0.07)",
    "e2": "0 2px 6px rgba(11,37,35,0.08), 0 20px 40px rgba(11,37,35,0.10)",
    "e3": "0 28px 72px rgba(11,37,35,0.16)",
    "overlayPhoto": "0 24px 64px rgba(2,12,11,.55), 0 2px 8px rgba(2,12,11,.35)"
  },
  "glass": {
    "light": {
      "background": "rgba(255,255,255,0.72)",
