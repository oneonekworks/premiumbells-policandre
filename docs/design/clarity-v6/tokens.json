      "border": "1px solid rgba(255,255,255,0.85)",
      "shadow": "e2 on header pill and bottom bar; captions none",
      "fallback": "rgba(255,255,255,0.96)",
      "use": [
        "header pill",
        "menus",
        "wall captions",
        "mobile bottom bar"
      ]
    },
    "onDark": {
      "background": "rgba(255,255,255,0.06)",
      "border": "1px solid rgba(255,255,255,0.12)",
      "hover": "rgba(255,255,255,0.12)",
      "fallback": "#173431",
      "use": [
        "lightbox controls",
        "Lightbox · Iconostase tabs"
      ]
    },
    "docked": {
      "background": "rgba(255,255,255,0.86)",
      "shadow": "0 14px 36px rgba(11,37,35,.20), 0 3px 8px rgba(11,37,35,.10), inset 0 0 0 1px rgba(255,255,255,.9)",
      "use": [
        "header and Works filter bar while docked"
      ]
    }
  },
  "shimmer": {
    "band": "30% width, rgba(255,226,170,0.28), blur 26px, skewX(-14deg), mix-blend screen",
    "duration": "1200ms",
    "use": "photos tagged gilded, once per hover/focus"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "duration": {
      "press": 120,
      "out": 160,
      "line": 180,
      "fade": 240,
      "close": 280,
      "open": 320,
      "card": 360,
      "page": 480,
      "image": 600,
      "text": 700,
      "reveal": 900,
      "shimmer": 1200,
      "counter": 1200
    },
    "stagger": {
      "grid": 60,
      "menu": 30,
      "text": 100
    },
    "reducedMotion": "all off or instant; page transitions become 120ms cross-fade"
  },
