# Public identifiers for the existing standalone sibling Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=1fzbw4s1
NEXT_PUBLIC_SANITY_DATASET=production
# Published public reads require no token. Never prefix a secret with NEXT_PUBLIC_.
# Signs the Sanity publish webhook (POST /api/revalidate). Server-only; generate
# with `openssl rand -hex 32`, keep it in .env.local and the host's env, and
# paste the same value into the webhook in sanity.io/manage.
SANITY_REVALIDATE_SECRET=
# Canonical site origin used for metadata (canonical, hreflang, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.policandre.ro
